rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// NIMA Link — กฎความปลอดภัยรายคอลเลกชัน (สัปดาห์ที่ 8)
// เขียนแทนกฎเดียวของสัปดาห์ที่ 7 ที่ว่า "ล็อกอินแล้วอ่าน/เขียนอะไรก็ได้"
// ทุกบล็อกข้างล่างมีคอมเมนต์กำกับว่ามาจากบรรทัดไหนของ ACL.md
//
// หลักการ
//   · role และ channel อ่านจาก users/{uid} ฝั่งเซิร์ฟเวอร์เท่านั้น
//     ไม่รับจาก query string / localStorage / ค่าที่ไคลเอนต์ส่งมาในเอกสาร
//   · OTC / MC เป็น hard gate — กันข้ามช่องทางทั้ง requests และ products
//   · Firestore ซ่อนเป็น "ฟิลด์" ไม่ได้ ซ่อนได้แค่ "ทั้งเอกสาร" — ชื่อร้านจึงถูกยกออกจาก
//     requests/{id} ไปอยู่ requests/{id}/identity/buyer (เส้นแดงข้อ 5 · PDPA)
//   · งานที่ยังค้างและข้อมูลเก่าที่ต้องล้างด้วยมือ บันทึกไว้ใน docs/security-rules.md
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── ตัวช่วย ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // โปรไฟล์ของคนที่ล็อกอินอยู่ — แหล่งเดียวของ role และ channel
    // ACL: "ระบบมี 2 บทบาท เก็บอยู่ที่ users/{uid}.role ... ไม่มีการส่ง role มาจากฝั่งหน้าจอ"
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isBuyer()   { return signedIn() && me().role == 'buyer'; }
    function isRep()     { return signedIn() && me().role == 'rep'; }
    function myChannel() { return me().channel; }

    // สถานะทั้ง 3 ค่า ต้องตรงกับ STATUS ใน app/db.js เป๊ะตัวอักษร
    function PENDING()  { return 'รอผู้แทนรับ'; }
    function ACCEPTED() { return 'รับแล้ว'; }
    function REJECTED() { return 'ปฏิเสธ'; }

    // ช่องของผู้ช่วย AI — เขียนโดย detail.html เท่านั้น และห้ามมี status ปนมาในชุดเดียวกัน
    function AI_FIELDS() { return ['aiSuggestion', 'aiReason', 'aiUpdatedAt']; }

    // ชุดช่องที่ถูกแก้จริงในคำสั่ง update นี้
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }


    // ── users/{uid} ──────────────────────────────────────────────────────────
    // ACL ทั้งสองบทบาท: "สมัครและเข้าสู่ระบบ" · "เปลี่ยน role ของตัวเองไม่ได้"
    // document id = uid จาก Firebase Auth จึงผูกสิทธิ์กับ uid ตรง ๆ ได้
    match /users/{uid} {

      function isMe() { return signedIn() && uid == request.auth.uid; }

      // อ่านได้เฉพาะโปรไฟล์ของตัวเอง — ระบบนี้ไม่มี role admin และไม่มีหน้าไหนอ่านโปรไฟล์คนอื่น
      allow get: if isMe();

      // ไม่มีหน้าไหนยิง query ทั้งคอลเลกชัน users — ปิดไว้ กันไล่เก็บรายชื่อผู้ใช้
      allow list: if false;

      // ตอนสมัคร app/auth.js เขียนโปรไฟล์ของตัวเองใบแรก
      // role / channel ต้องเป็นค่าที่ระบบรู้จักเท่านั้น (เส้นแดงข้อ 4 — OTC/MC ล็อกตั้งแต่สมัคร)
      allow create: if isMe()
                    && request.resource.data.role in ['buyer', 'rep']
                    && request.resource.data.channel in ['OTC', 'MC'];

      // แก้โปรไฟล์ตัวเองได้ (ชื่อ เขต) แต่ role กับ channel ห้ามขยับ
      // ACL: "เปลี่ยน role ของตัวเองไม่ได้" · เส้นแดงข้อ 4 "ไม่ใช่ช่องติ๊กให้ผู้ใช้เปลี่ยนเอง"
      allow update: if isMe()
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.channel == resource.data.channel;

      // ลบโปรไฟล์ไม่ได้ — ไม่มีฟีเจอร์นี้ในขอบเขต Module 2
      allow delete: if false;
    }


    // ── products/{productId} ─────────────────────────────────────────────────
    // ACL ร้าน: "เห็นชื่อรายการยาเฉพาะช่องทางของตัวเอง" · "แก้ไขรายการยาในระบบไม่ได้"
    // เส้นแดงข้อ 4 — OTC/MC เป็น hard gate กรองก่อนคิดอะไรทั้งสิ้น
    match /products/{productId} {

      // new.html ยิง where("channel","==",me.channel) — ตรงรูปกฎข้อนี้พอดี ไม่ต้องแก้ query
      allow list: if signedIn() && resource.data.channel == myChannel();

      // detail.html (ผู้ช่วย AI ขั้นที่ 2) อ่านรายการยาทีละใบด้วย productId
      // resource == null คือใบที่ถูกลบไปแล้ว — ยอมให้รู้แค่ว่า "ไม่มีเอกสารนี้"
      // ไม่ได้เปิดเผยข้อมูลใด และทำให้หน้าเว็บเดินต่อได้แทนที่จะโยน permission-denied
      allow get: if signedIn() && (resource == null || resource.data.channel == myChannel());

      // ไม่มีบทบาทไหนเขียน products ได้ — ใส่ผ่าน Firebase Console เท่านั้น
      allow write: if false;
    }


    // ── requests/{requestId} ─────────────────────────────────────────────────
    // โฟลเดอร์หลักของ Module 2 — ครอบทั้งสองแถวของตาราง ACL
    match /requests/{requestId} {

      function isOwner()        { return signedIn() && resource.data.buyerId == request.auth.uid; }
      function repSameChannel() { return isRep() && resource.data.buyerChannel == myChannel(); }

      // อ่านทีละใบ (detail.html)
      // ACL ร้าน: "ดูคำขอของร้านอื่นไม่ได้" · ACL ผู้แทน: "ดูคำขอข้ามช่องทาง OTC/MC ไม่ได้"
      // resource == null คือคำขอที่ถูกลบไปแล้ว — ปล่อยให้หน้าเว็บขึ้น "ไม่พบคำขอใบนี้" ได้ตามเดิม
      allow get: if signedIn() && (resource == null || isOwner() || repSameChannel());

      // list — index.html ยิงมาแค่ 2 รูป เขียนแยกเป็น 2 ข้อให้ตัววิเคราะห์ query จับคู่ได้ตรง ๆ
      // ร้าน: where("buyerId","==",uid) — ACL "ดูคำขอของร้านตัวเองทั้งหมด"
      allow list: if isBuyer() && resource.data.buyerId == request.auth.uid;
      // ผู้แทน: where("buyerChannel","==",channel) — ACL "ดูคำขอในช่องทางเดียวกับตัวเอง"
      allow list: if isRep() && resource.data.buyerChannel == myChannel();

      // สร้างคำขอ — ACL ร้าน "สร้างคำขอหายา" / ACL ผู้แทน "สร้างคำขอไม่ได้"
      //   · buyerId ต้องเป็น uid ของตัวเอง  → ปลอมเป็นร้านอื่นไม่ได้
      //   · buyerChannel ต้องตรงโปรไฟล์     → ยัดคำขอข้ามช่องทางไม่ได้ (เส้นแดงข้อ 4)
      //   · status ต้องเริ่มที่ รอผู้แทนรับ → ตั้งสถานะให้ตัวเองตั้งแต่แรกไม่ได้
      //   · ห้ามมี buyerName ติดมาบนเอกสารคำขอ (เส้นแดงข้อ 5 — ชื่อร้านย้ายไป identity/buyer แล้ว)
      //   · ห้ามมี acceptedBy ตั้งแต่แรก — ช่องนี้เป็นของผู้แทนตอนกดรับเท่านั้น
      allow create: if isBuyer()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerChannel == myChannel()
                    && request.resource.data.status == PENDING()
                    && !request.resource.data.keys().hasAny(['buyerName', 'acceptedBy']);

      // ลบคำขอ — ACL ร้าน "ลบคำขอของตัวเอง" / "ลบคำขอของร้านอื่นไม่ได้"
      // ACL ผู้แทน "ลบคำขอไม่ได้" → กันด้วย isBuyer()
      allow delete: if isBuyer() && resource.data.buyerId == request.auth.uid;

      // update ข้อ 1 — ผู้แทนกดรับ / กดปฏิเสธ
      // ACL ผู้แทน: "แก้ไขช่องอื่นของคำขอไม่ได้ นอกจากช่อง status"
      //             "เปลี่ยนสถานะซ้ำหลังตอบไปแล้วไม่ได้"
      // ACL ร้าน:   "เปลี่ยนสถานะคำขอไม่ได้ แม้เป็นคำขอของตัวเอง" → ไม่มี allow update ให้ buyer เลย
      //
      // acceptedBy = uid ของผู้แทนที่กดรับ ต้องเขียนพร้อม status ในคำสั่งเดียวกัน
      // มีไว้ตอบคำถามว่า "ใคร" เป็นคนรับ — ตัวที่ใช้เปิดสิทธิ์อ่าน identity/buyer
      // ถ้าไม่มีช่องนี้ ผู้แทนคนอื่นทั้งช่องทางจะเห็นชื่อร้านตามไปด้วยทันทีที่มีใครสักคนกดรับ
      allow update: if repSameChannel()
                    && changedKeys().hasOnly(['status', 'acceptedBy'])
                    && resource.data.status == PENDING()
                    && (
                      // กดรับ — ต้องเซ็นชื่อว่าเป็นตัวเอง จะยกให้คนอื่นรับแทนไม่ได้
                      (request.resource.data.status == ACCEPTED()
                        && request.resource.data.get('acceptedBy', '') == request.auth.uid)
                      ||
                      // กดปฏิเสธ — ห้ามแตะ acceptedBy เลย ไม่มีใครได้สิทธิ์เห็นชื่อร้านจากการปฏิเสธ
                      (request.resource.data.status == REJECTED()
                        && !changedKeys().hasAny(['acceptedBy']))
                    );

      // update ข้อ 2 — ผู้ช่วย AI ระดับ 2 เขียนผลกลับลงคำขอ (detail.html)
      // hasOnly กันไม่ให้ยัด status ปนมาในชุดเดียวกัน — เปลี่ยนสถานะทางนี้ไม่ได้
      allow update: if repSameChannel()
                    && changedKeys().hasOnly(AI_FIELDS());


      // ── requests/{requestId}/identity/{docId} ──────────────────────────────
      // 🔴 เส้นแดงข้อ 5 (PDPA) — "ผู้แทนห้ามเห็นชื่อ / ที่อยู่ร้าน จนกว่าจะกดรับคำขอ"
      //
      // Firestore ซ่อนเป็น "ฟิลด์" ไม่ได้ ซ่อนได้แค่ "ทั้งเอกสาร"
      // จึงยก buyerName ออกจาก requests/{id} มาไว้เป็นเอกสารของตัวเองที่ล็อกทั้งใบได้
      // doc id ตายตัวว่า buyer เพื่อให้หน้าเว็บ getDoc ตรงได้ ไม่ต้อง list
      // buyerArea ยังอยู่บนเอกสารคำขอตามเดิม — ACL ให้ผู้แทนเห็น "เขต" ได้ก่อนกดรับ
      match /identity/{docId} {

        function parentReq() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }

        // อ่านได้ 2 กรณีเท่านั้น
        //   1. ร้านเจ้าของคำขอ — ชื่อตัวเอง
        //   2. ผู้แทน "คนที่กดรับใบนี้" เท่านั้น — ไม่ใช่ผู้แทนทุกคนในช่องทาง
        allow get: if signedIn() && (
                     parentReq().buyerId == request.auth.uid ||
                     (parentReq().status == ACCEPTED() &&
                      parentReq().get('acceptedBy', '') == request.auth.uid)
                   );

        // ไม่มีหน้าไหนต้องไล่อ่านทั้งโฟลเดอร์ย่อย — ปิดไว้
        allow list: if false;

        // สร้างพร้อมคำขอใน writeBatch ก้อนเดียว (new.html)
        // ต้องใช้ getAfter ไม่ใช่ get เพราะตอนกฎทำงาน เอกสารคำขอในก้อนเดียวกันยังไม่ commit
        // get() จะเห็นสถานะ "ก่อน" ก้อนนี้ คือยังไม่มีเอกสารแม่ แล้วจะปฏิเสธทั้งที่ถูกต้อง
        allow create: if isBuyer()
                      && getAfter(/databases/$(database)/documents/requests/$(requestId))
                           .data.buyerId == request.auth.uid;

        // แก้ / ลบ ได้เฉพาะร้านเจ้าของคำขอ — ผู้แทนแตะไม่ได้ทั้งสองอย่าง
        allow update, delete: if signedIn() && parentReq().buyerId == request.auth.uid;
      }


      // ── requests/{requestId}/replies/{replyId} ─────────────────────────────
      // คำตอบของผู้แทนในคำขอใบนั้น — ยังไม่มี UI เขียน (เพื่อนร่วมทีมทำรอบหน้า)
      // สิทธิ์ล้อ ACL แถวผู้แทน: ตอบได้เฉพาะคำขอในช่องทางเดียวกับตัวเอง
      match /replies/{replyId} {

        function parentReq() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        // ร้านเจ้าของคำขออ่านคำตอบได้ · ผู้แทนช่องทางเดียวกันอ่านได้
        // ไม่อ้างอิง resource.data จึงยิง getDocs ทั้งโฟลเดอร์ย่อยได้โดยไม่ต้องใส่ where
        // (detail.html ผู้ช่วย AI ขั้นที่ 3 ยิงแบบนั้นอยู่)
        function canSeeParent() {
          return signedIn() && (
            parentReq().buyerId == request.auth.uid ||
            (isRep() && parentReq().buyerChannel == myChannel())
          );
        }

        allow get, list: if canSeeParent();

        // เขียนคำตอบได้เฉพาะผู้แทนในช่องทางเดียวกัน และต้องเซ็นชื่อด้วย uid ตัวเอง
        allow create: if isRep()
                      && parentReq().buyerChannel == myChannel()
                      && request.resource.data.repId == request.auth.uid;

        // แก้ / ลบคำตอบของคนอื่นไม่ได้ และย้ายเจ้าของคำตอบไม่ได้
        allow update: if isRep()
                      && resource.data.repId == request.auth.uid
                      && request.resource.data.repId == resource.data.repId;
        allow delete: if isRep() && resource.data.repId == request.auth.uid;
      }


      // ── requests/{requestId}/aiLog/{logId} ─────────────────────────────────
      // บันทึกทุกครั้งที่ผู้ช่วย AI ระดับ 2 ทำงาน — มีไว้ตรวจย้อนหลัง จึงห้ามแก้ห้ามลบ
      match /aiLog/{logId} {

        function parentReq() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        function canSeeParent() {
          return signedIn() && (
            parentReq().buyerId == request.auth.uid ||
            (isRep() && parentReq().buyerChannel == myChannel())
          );
        }

        allow get, list: if canSeeParent();

        // เขียนได้เฉพาะผู้แทนช่องทางเดียวกัน และต้องจด byUid เป็น uid ตัวเอง
        allow create: if isRep()
                      && parentReq().buyerChannel == myChannel()
                      && request.resource.data.byUid == request.auth.uid;

        allow update, delete: if false;
      }
    }


    // ── ที่เหลือปิดหมด ───────────────────────────────────────────────────────
    // อะไรที่ไม่ได้ระบุไว้ข้างบน ถือว่าไม่อนุญาต — ไม่มีรูโหว่ค้างไว้ให้คอลเลกชันที่ยังไม่ได้คิด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
