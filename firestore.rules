rules_version = '2';

// กฎขั้นต่ำของสัปดาห์ที่ 7 — ต้องล็อกอินก่อนจึงอ่านหรือเขียนได้
//
// ยังไม่พอสำหรับของจริง: ใครสมัครเข้ามาก็ยังอ่านของคนอื่นได้
// การกันข้ามร้าน กันข้ามช่องทาง OTC/MC และการซ่อนชื่อร้านจนผู้แทนกดรับ
// ตอนนี้บังคับอยู่ที่ฝั่งหน้าเว็บเท่านั้น ต้องย้ายลงมาเป็นกฎในสัปดาห์ที่ 8
// ห้ามใส่ข้อมูลจริงของคนอื่นจนกว่าจะทำสัปดาห์ที่ 8 เสร็จ

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
